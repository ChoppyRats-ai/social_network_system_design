// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs
// =====================================================
// Репликация
// =====================================================
// Для базы данных выбрана репликация типа primary-replica.
// Запись выполняется только на primary-узел,
// а операции чтения распределяются между read-replicas.
//
// Выбран асинхронный тип репликации,
// так как для социальной сети важнее высокая производительность
// и скорость чтения, чем мгновенная консистентность на всех репликах.
// Небольшая задержка в обновлении данных на репликах допустима,
// например если лайк или комментарий появляется с небольшой задержкой.

// =====================================================
// Шардирование
// =====================================================
// Используется горизонтальное шардирование для наиболее
// быстрорастущих и нагруженных сущностей.
//
// messages:
// шардирование по chat_id, так как сообщения чаще всего читаются
// в рамках конкретного чата, и хранение истории чата на одном шарде
// уменьшает количество межшардовых запросов.
//
// posts:
// шардирование по author_id, так как посты одного пользователя
// удобно хранить вместе для быстрой загрузки его профиля и публикаций.
//
// comments:
// шардирование по post_id, так как комментарии логически относятся
// к конкретному посту и обычно запрашиваются вместе с ним.
//
// likes:
// шардирование по post_id, так как лайки также относятся
// к конкретному посту и часто используются вместе с его просмотром.
//
// users:
// на текущем этапе таблица users не шардируется,
// так как основной рост нагрузки ожидается на сообщениях,
// постах, комментариях и лайках.
// При дальнейшем росте системы возможно шардирование по user_id.


Table users {
  id integer [primary key]
  username varchar
  description varchar
  city varchar
  created_at timestamp
  avatar_url varchar
  interests text
}


Table posts {
  id integer [primary key]
  user_id integer
  description text
  media_id integer
  hashtags varchar
  likes_count integer
  views_count integer
  created_at timestamp
}

Table comments {
  id integer [primary key]
  post_id integer
  user_id integer
  text text
  created_at timestamp
}

Table chats {
  id integer [primary key]
  type varchar
  created_at timestamp
}

Table messages {
  id integer [primary key]
  chat_id integer
  sender_id integer
  text text
  is_read boolean
  created_at timestamp
}

Table media {
  id integer [primary key]
  type varchar
  url varchar
}


Table relationships {
  id integer [primary key]
  user_id integer
  target_user_id integer
  type varchar
}

Ref: posts.user_id > users.id
Ref: comments.post_id > posts.id
Ref: comments.user_id > users.id
Ref: messages.chat_id > chats.id
Ref: messages.sender_id > users.id
Ref: relationships.user_id > users.id
Ref: relationships.target_user_id > users.id
Ref: posts.media_id > media.id